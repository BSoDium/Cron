<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- DEBUG-ONLY. Fires the same repository-layer replan path the Home FAB uses, without
             a tap or navigation, so dev-tooling repros are deterministic and scriptable:
             adb shell am broadcast -a fr.bsodium.cron.debug.TRIGGER_AI_TURN
             Intentionally unauthenticated: absent from release builds entirely (this manifest and
             the receiver class both live under app/src/debug), so a co-installed app can at worst
             kick off a fake AI turn on a developer's own debug build. -->
        <receiver
            android:name=".debug.receiver.TimelineReproReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>

</manifest>
